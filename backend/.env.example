# Copy to backend/.env and fill in. Never commit the real .env file.

ENVIRONMENT=development
# SQLite for local development; use PostgreSQL in production, e.g.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME
DATABASE_URL=sqlite:///./stockout.db
# Required in production. Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-with-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=60
BCRYPT_ROUNDS=12
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Demo mode: enables fictional demo data, the USSD/SMS simulators and demo reset.
# Set DEMO_MODE=false for any real deployment.
DEMO_MODE=true
# Password for all fictional demo accounts (seeded on `python -m app.seed demo`).
# Uncomment to override the built-in demo default.
# DEMO_PASSWORD=choose-a-demo-password
# Comma-separated E.164 numbers allowed to receive LIVE SMS while DEMO_MODE=true
# (e.g. your own test handset). All other recipients are simulated.
DEMO_SMS_ALLOWLIST=
# Optional: your own test handset, attached to the demo pharmacist so you can
# try SMS stock commands end-to-end.
DEMO_STAFF_PHONE=

# Africa's Talking. Leave blank to run fully simulated.
AT_USERNAME=
AT_API_KEY=
# Approved alphanumeric sender ID or short code (leave blank to use the AT default)
AT_SENDER_ID=
# sandbox | live
AT_ENVIRONMENT=sandbox
# Shared secret appended to callback URLs as ?token=... (required outside demo mode)
AT_WEBHOOK_TOKEN=
# Optional comma-separated IP allowlist for callbacks
AT_WEBHOOK_ALLOWED_IPS=
# The USSD code assigned to you, e.g. *384*1234#
AT_USSD_SERVICE_CODE=
# Force simulation even when AT credentials are present
SMS_FORCE_SIMULATION=false
SMS_HTTP_TIMEOUT_SECONDS=10
SMS_MAX_ATTEMPTS=3
SMS_RETRY_BASE_SECONDS=60

# Freshness defaults (can also be changed at runtime in Settings)
FRESH_HOURS=72
UNKNOWN_AFTER_DAYS=30

SCHEDULER_ENABLED=true
SCHEDULER_INTERVAL_SECONDS=60
USSD_SESSION_TIMEOUT_SECONDS=180
RATE_LIMIT_PUBLIC_PER_MINUTE=60
RATE_LIMIT_SENSITIVE_PER_MINUTE=10
